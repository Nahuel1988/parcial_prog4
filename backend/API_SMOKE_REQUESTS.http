@baseUrl = http://127.0.0.1:8000
@json = application/json

### Health
GET {{baseUrl}}/

### ======================================================
### Catalogo (smoke)
### ======================================================

### Crear categoria
POST {{baseUrl}}/categorias/
Content-Type: {{json}}

{
  "parent_id": null,
  "nombre": "Pizzas",
  "descripcion": "Categoria smoke",
  "imagen_url": null
}

### Crear ingrediente
POST {{baseUrl}}/ingredientes/
Content-Type: {{json}}

{
  "nombre": "Queso",
  "descripcion": "Mozzarella",
  "es_alergeno": true
}

### Crear producto
POST {{baseUrl}}/productos/
Content-Type: {{json}}

{
  "nombre": "Pizza Muzzarella",
  "descripcion": "Producto smoke",
  "precio_base": 3500,
  "imagenes_url": null,
  "stock_cantidad": 10,
  "disponible": true
}

### Listar productos
GET {{baseUrl}}/productos/?offset=0&limit=10

### Vincular producto-categoria
POST {{baseUrl}}/producto-categorias/
Content-Type: {{json}}

{
  "producto_id": 1,
  "categoria_id": 1,
  "es_principal": true
}

### Vincular producto-ingrediente
POST {{baseUrl}}/producto-ingredientes/
Content-Type: {{json}}

{
  "producto_id": 1,
  "ingrediente_id": 1,
  "es_removible": true
}

### Obtener producto con relaciones
GET {{baseUrl}}/productos/1

### ======================================================
### Validaciones esperadas (catalogo)
### ======================================================

### Path invalido (esperado 422 por Path(gt=0))
GET {{baseUrl}}/productos/0
